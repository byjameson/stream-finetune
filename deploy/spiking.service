[Unit]
Description=streamft spiking LM HTTP server
After=network.target

[Service]
Type=simple
User=spiking
Group=spiking
WorkingDirectory=/opt/spiking
EnvironmentFile=-/etc/spiking.env
ExecStart=/opt/spiking/venv/bin/streamft spiking serve --model /opt/spiking/checkpoints/spiking_4m_full --host 127.0.0.1 --port 8011
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/spiking/checkpoints
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
